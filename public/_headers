# Заголовки для статического хостинга (Netlify / Cloudflare Pages).
# Service worker и манифест должны браться свежими, чтобы обновления доезжали до телефона.
/sw.js
  Cache-Control: no-cache
  Service-Worker-Allowed: /
/manifest.json
  Cache-Control: no-cache

# Хешированные ассеты Expo (имя содержит хеш) можно кэшировать надолго.
/_expo/*
  Cache-Control: public, max-age=31536000, immutable
/assets/*
  Cache-Control: public, max-age=31536000, immutable
